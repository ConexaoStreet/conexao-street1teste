@echo off
setlocal EnableExtensions DisableDelayedExpansion
title Executador - PC
set "EXECUTADOR_SELF=%~f0"
set "EXPECTED_AGENT_SHA256=823283bd8feb8fa89544a6bdfafaa4dc5804c8fa92989313bb30f4a213a5ee42"
set "EXPECTED_LOCAL_SHA256=7d7979ecdf4a3d5be537136b1ac1b527d208d69cbd2e33f483e3f638b2f69bc2"

if /I "%~1"=="SELFTEST" goto :selftest
if /I "%~1"=="ELEVATED" goto :elevated

echo.
echo ==============================================
echo          EXECUTADOR - MODO PC DIRETO
echo ==============================================
echo.
echo Solicitando permissao de Administrador...
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$q=[char]34; $p=$env:EXECUTADOR_SELF; try { Start-Process -FilePath 'cmd.exe' -Verb RunAs -ArgumentList ('/c ' + $q + $p + $q + ' ELEVATED'); exit 0 } catch { Write-Host $_.Exception.Message -ForegroundColor Red; exit 1 }"
if errorlevel 1 (
  echo [ERRO] Nao foi possivel abrir como Administrador.
  pause
)
exit /b

:elevated
fltmc >nul 2>&1
if errorlevel 1 (
  echo [ERRO] Esta janela nao esta como Administrador.
  pause
  exit /b 1
)
set "ROOT=%ProgramData%\Executador"
set "AGENT=%ROOT%\ExecutadorAgent.ps1"
set "LOCAL=%ROOT%\ExecutadorLocal.ps1"
set "EXECUTADOR_AGENT=%AGENT%"
set "EXECUTADOR_LOCAL=%LOCAL%"
if not exist "%ROOT%" mkdir "%ROOT%"

echo Preparando Executador local...
call :extract
if errorlevel 1 (
  echo.
  echo [ERRO] Falha ao validar os arquivos internos do Executador.
  pause
  exit /b 1
)
echo Arquivos internos validados.
echo Abrindo painel local...
powershell.exe -STA -NoProfile -ExecutionPolicy Bypass -File "%LOCAL%" -AgentPath "%AGENT%"
set "RC=%ERRORLEVEL%"
if not "%RC%"=="0" (
  echo.
  echo [ERRO] O painel local terminou com codigo %RC%.
  echo Log: %ProgramData%\Executador\logs\agent.log
  pause
)
exit /b %RC%

:selftest
set "ROOT=%TEMP%\ExecutadorPcSelfTest"
set "AGENT=%ROOT%\ExecutadorAgent.ps1"
set "LOCAL=%ROOT%\ExecutadorLocal.ps1"
set "EXECUTADOR_AGENT=%AGENT%"
set "EXECUTADOR_LOCAL=%LOCAL%"
if exist "%ROOT%" rmdir /s /q "%ROOT%" >nul 2>&1
mkdir "%ROOT%" >nul 2>&1
call :extract
if errorlevel 1 exit /b 1
powershell.exe -STA -NoProfile -ExecutionPolicy Bypass -File "%LOCAL%" -AgentPath "%AGENT%" -SelfTest
set "RC=%ERRORLEVEL%"
rmdir /s /q "%ROOT%" >nul 2>&1
exit /b %RC%

:extract
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; try { $raw=[IO.File]::ReadAllText($env:EXECUTADOR_SELF); $m1='::EXECUTADOR_AGENT_'+'BASE64::'; $m2='::EXECUTADOR_LOCAL_'+'BASE64::'; $p1=$raw.IndexOf($m1,[StringComparison]::Ordinal); $p2=$raw.IndexOf($m2,[StringComparison]::Ordinal); if($p1 -lt 0 -or $p2 -le $p1){throw 'Payload interno invalido.'}; $s1=$p1+$m1.Length; $b1=($raw.Substring($s1,$p2-$s1) -replace '\s',''); $b2=($raw.Substring($p2+$m2.Length) -replace '\s',''); $a=[Convert]::FromBase64String($b1); $l=[Convert]::FromBase64String($b2); [IO.File]::WriteAllBytes($env:EXECUTADOR_AGENT,$a); [IO.File]::WriteAllBytes($env:EXECUTADOR_LOCAL,$l); $ha=(Get-FileHash $env:EXECUTADOR_AGENT -Algorithm SHA256).Hash.ToLowerInvariant(); $hl=(Get-FileHash $env:EXECUTADOR_LOCAL -Algorithm SHA256).Hash.ToLowerInvariant(); if($ha -ne $env:EXPECTED_AGENT_SHA256){throw 'SHA do Agent invalido.'}; if($hl -ne $env:EXPECTED_LOCAL_SHA256){throw 'SHA do painel invalido.'}; exit 0 } catch { Write-Host ('Falha: '+$_.Exception.Message) -ForegroundColor Red; exit 1 }"
exit /b %ERRORLEVEL%

goto :eof
